{
    "name": "nativeblade/ui-mobile",
    "description": "Mobile UI components for NativeBlade. Konsta-style iOS and Material 3 Blade components that auto-switch theme based on the running platform.",
    "keywords": ["nativeblade", "laravel", "blade", "ui", "mobile", "ios", "material", "tailwind"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson T.S",
            "email": "jeffleyd@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NativeBlade\\UiMobile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NativeBlade\\UiMobile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NativeBlade\\UiMobile\\UiMobileServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
